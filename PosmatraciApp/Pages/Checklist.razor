@page "/checklist/{BmId}"
@inject AuthService AuthService
@inject ChecklistService ChecklistService
@inject LocationService LocationService
@inject IzlaznostService IzlaznostService
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Чек-листа — @(_state?.BmDisplayName ?? "")</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <MudText>Нисте пријављени.</MudText>
    return;
}

@if (_state == null)
{
    <div style="display:flex;justify-content:center;padding:32px;">
        <MudProgressCircular Indeterminate="true" />
    </div>
    return;
}

<!-- Drawer -->
<MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Left" Elevation="2" Variant="DrawerVariant.Temporary" ClipMode="DrawerClipMode.Never">
    <MudDrawerHeader>
        <MudText Typo="Typo.subtitle2" Style="font-weight:600;word-break:break-word;">
            @_state.BmShortId. @_state.BmDisplayName
        </MudText>
    </MudDrawerHeader>
    <MudDivider />
    <MudList T="string" Style="padding-top:8px;">
        <MudListItem T="string" Icon="@Icons.Material.Filled.HowToVote"
                     OnClick="@(() => { _drawerOpen = false; Nav.NavigateTo($"/izlaznost/{BmId}"); })">
            Излазност
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.Share"
                     OnClick="@(() => { _drawerOpen = false; _ = ExportAndShare(); })">
            Извоз / Подели
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.AddLocation"
                     OnClick="@(() => { _drawerOpen = false; AddBm(); })">
            Додај БМ
        </MudListItem>
        <MudDivider Style="margin:8px 0;" />
        <MudListItem T="string" Icon="@Icons.Material.Filled.Logout"
                     OnClick="@(() => { _drawerOpen = false; _ = Logout(); })">
            Одјава
        </MudListItem>
    </MudList>
</MudDrawer>

<!-- Top AppBar -->
<MudAppBar Elevation="1" Color="Color.Primary" Fixed="true" Dense="true">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                   OnClick="@(() => _drawerOpen = !_drawerOpen)" />
    <MudText Typo="Typo.subtitle1" Style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;">
        @_state.BmShortId. @_state.BmDisplayName
    </MudText>
    <MudSpacer />
    <MudChip T="string" Color="@GetOverallProgressColor()" Variant="Variant.Filled" Size="Size.Small"
             Style="margin-right:4px;">
        @_state.AnsweredCount/@_state.TotalItems
    </MudChip>
    <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Inherit"
                   OnClick="SendToServer" Disabled="@_sending" Title="Пошаљи извештај на сервер" />
</MudAppBar>

<!-- BM Switcher -->
@if (AuthService.CurrentSession!.ActiveBmIds.Count > 1)
{
    <div style="position:fixed;top:48px;left:0;right:0;z-index:900;background:white;border-bottom:1px solid #eee;overflow-x:auto;white-space:nowrap;padding:6px 8px;">
        @foreach (var bmId in AuthService.CurrentSession.ActiveBmIds)
        {
            var bm = LocationService.FindBm(bmId);
            var isCurrent = bmId == BmId;
            <MudChip T="string"
                     Color="@(isCurrent ? Color.Primary : Color.Default)"
                     Variant="@(isCurrent ? Variant.Filled : Variant.Outlined)"
                     Size="Size.Small"
                     Style="margin-right:4px;"
                     OnClick="@(() => SwitchBm(bmId))">
                @(bm == null ? bmId : $"{bm.ShortId}. {bm.Name}")
            </MudChip>
        }
    </div>
}

<!-- Content -->
<div style="padding-top:@(AuthService.CurrentSession.ActiveBmIds.Count > 1 ? "92px" : "56px");padding-bottom:16px;">

    <!-- BM Info -->
    <div style="padding:12px 16px 0;">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @_state.OpstineName › @_state.BjName
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Сачувано: @_state.LastModified.ToLocalTime().ToString("HH:mm")
        </MudText>
    </div>

    <!-- Checklist Sections -->
    <MudExpansionPanels MultiExpansion="false" Style="padding:8px;">
        @foreach (var sect in ChecklistService.Sections)
        {
            <ChecklistSection Section="@sect"
                              State="@_state"
                              OnAnswerChanged="@((t) => OnAnswerChanged(t.id, t.answer))"
                              OnSeverityChanged="@((t) => OnSeverityChanged(t.id, t.severity))"
                              OnNoteChanged="@((t) => OnNoteChanged(t.id, t.note))" />
        }
    </MudExpansionPanels>
</div>


@code {
    [Parameter] public string BmId { get; set; } = "";

    private BmState? _state;
    private bool _drawerOpen;
    private bool _sending;
    private string _serverUrl = "";

    protected override void OnParametersSet()
    {
        LoadState();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        try
        {
            var config = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>("data/config.json");
            _serverUrl = config.GetProperty("serverUrl").GetString() ?? "";
        }
        catch { }
    }

    private void LoadState()
    {
        _state = ChecklistService.GetBmState(BmId);
        if (_state == null)
        {
            var bm = LocationService.FindBm(BmId);
            if (bm == null)
            {
                Nav.NavigateTo("/location-select");
                return;
            }
            var ctx = LocationService.GetBmContext(BmId);
            _state = ChecklistService.GetOrCreateBmState(bm, ctx.opstinaName, ctx.bjName);
        }
    }

    private void OnAnswerChanged(int id, AnswerState answer)
    {
        ChecklistService.SetAnswer(BmId, id, answer);
        StateHasChanged();
    }

    private void OnSeverityChanged(int id, CheckSeverity severity)
    {
        ChecklistService.SetSeverity(BmId, id, severity);
    }

    private void OnNoteChanged(int id, string note)
    {
        ChecklistService.SetNote(BmId, id, note);
    }

    private void SwitchBm(string bmId)
    {
        AuthService.CurrentSession!.CurrentBmId = bmId;
        Nav.NavigateTo($"/checklist/{bmId}");
    }

    private void AddBm()
    {
        Nav.NavigateTo("/location-select");
    }

    private async Task Logout()
    {
        await ChecklistService.SaveAllAsync();
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    /// <summary>
    /// Šalje podatke direktno na server API — bez QR dialoga.
    /// </summary>
    private async Task SendToServer()
    {
        if (_state == null || _sending) return;
        _sending = true;
        StateHasChanged();

        await ChecklistService.SaveAllAsync();

        if (string.IsNullOrWhiteSpace(_serverUrl))
        {
            Snackbar.Add("Сервер URL није подешен у config.json.", MudBlazor.Severity.Warning);
            _sending = false;
            StateHasChanged();
            return;
        }

        try
        {
            var izlaznost = IzlaznostService.Get(BmId);
            var req = new SubmitRequest
            {
                Email = AuthService.CurrentSession!.Email,
                BmState = _state,
                BmIzlaznost = izlaznost
            };
            var response = await Http.PostAsJsonAsync($"{_serverUrl.TrimEnd('/')}/api/submit", req);
            if (response.IsSuccessStatusCode)
                Snackbar.Add("✓ Подаци послати на сервер.", MudBlazor.Severity.Success);
            else
                Snackbar.Add("Сервер није примио податке. Користите JSON извоз.", MudBlazor.Severity.Warning);
        }
        catch
        {
            Snackbar.Add("Сервер недоступан — користите JSON извоз.", MudBlazor.Severity.Error);
        }

        _sending = false;
        StateHasChanged();
    }

    /// <summary>
    /// Kreira JSON i odmah deli (Web Share API) ili preuzima kao fallback.
    /// </summary>
    private async Task ExportAndShare()
    {
        if (_state == null) return;
        await ChecklistService.SaveAllAsync();
        var izlaznost = IzlaznostService.Get(BmId);
        var req = new SubmitRequest
        {
            Email = AuthService.CurrentSession!.Email,
            BmState = _state,
            BmIzlaznost = izlaznost
        };
        var json = System.Text.Json.JsonSerializer.Serialize(req, new System.Text.Json.JsonSerializerOptions { WriteIndented = false });
        var filename = $"bm{_state.BmShortId}-{DateTime.Now:yyyyMMdd-HHmm}.json";
        await JS.InvokeVoidAsync("shareJson", json, filename, _state.BmDisplayName);
    }

    private Color GetOverallProgressColor()
    {
        if (_state == null) return Color.Default;
        if (_state.AnsweredCount == 0) return Color.Default;
        if (_state.AnsweredCount == _state.TotalItems) return Color.Success;
        return Color.Warning;
    }
}
